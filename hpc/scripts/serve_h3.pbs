#!/bin/bash
#PBS -q c30636g
#PBS -W group_list=c30636
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -N h3_serve
#PBS -j oe
#PBS -o /lustre1/work/c30636/test/minimax-h3/logs/
# MiniMax-H3 (FL2VA partition: t2va + fl2va) served by SGLang on 4xH100 80GB.
# Topology from the SGLang cookbook's verified 4xH100 recipe: TP2 + Ulysses2, resident weights.
set -uo pipefail
ROOT=${H3_ROOT:-/lustre1/work/c30636/test/minimax-h3}   # work dir: models/, outputs/, logs/, tools/
VARIANT=${VARIANT:-fl2va}          # fl2va | ref2va  (ref2va needs models/MiniMax-H3/Ref2VA downloaded)
PORT=${PORT:-30010}

source ~/miniconda3/etc/profile.d/conda.sh
conda activate minimax-h3
export PYTHONNOUSERSITE=1   # ~/.local has a stale huggingface_hub that shadows the env
module load cuda/13.0.2 2>/dev/null || true

export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TOKENIZERS_PARALLELISM=false
export SGLANG_DIFFUSION_CACHE_ROOT=${SGLANG_DIFFUSION_CACHE_ROOT:-/lustre1/work/c30636/test/fasth3/cache/sgl_diffusion}   # home (/lustre0) is ~full; keep overlay/compile caches on lustre1
cd $ROOT

echo "job $PBS_JOBID on $(hostname) start $(date)"
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv
echo "$(hostname):$PORT" > logs/server_endpoint.txt

# PBS exports CUDA_VISIBLE_DEVICES as GPU UUIDs; sglang needs integer indices. Map UUID -> index.
if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* ]]; then
  idx=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader | tr -d ' ' | awk -F, -v want="$CUDA_VISIBLE_DEVICES" '
    BEGIN{n=split(want,w,",")} {u[$2]=$1} END{for(i=1;i<=n;i++){printf "%s%s",(i>1?",":""),u[w[i]]}}')
  echo "CUDA_VISIBLE_DEVICES $CUDA_VISIBLE_DEVICES -> $idx"; export CUDA_VISIBLE_DEVICES=$idx
fi

# GPU utilisation sidecar: sample util/mem/power every 5 s for the life of the job
nvidia-smi dmon -s pucm -d 5 -o T > logs/gpu_dmon_${PBS_JOBID%%.*}.log 2>&1 &
DMON_PID=$!

sglang serve --model-type diffusion \
  --model-path $ROOT/models/MiniMax-H3 \
  --model-variant $VARIANT \
  --num-gpus 4 \
  --tp-size 2 \
  --ulysses-degree 2 \
  --encoder-parallel auto \
  --performance-mode speed \
  --host 0.0.0.0 \
  --port $PORT
kill $DMON_PID 2>/dev/null
echo "server exited $(date)"
rm -f logs/server_endpoint.txt
